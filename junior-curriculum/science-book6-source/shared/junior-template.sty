% write-on line
\newcommand{\wline}[1][3cm]{\rule[-2pt]{#1}{0.5pt}}

% ---------------------------------------------------------------- the observation ladder
\newcommand{\ladder}[1][1]{%
  \begin{tikzpicture}[scale=#1,font=\sffamily\scriptsize]
    \foreach \i/\t/\c/\d in {0/observed/sky/{what was seen},1/counted/leaf/{a number, with the method used},2/estimated/tangerine/{a number about more than was counted},3/concluded/grape/{a claim about why}}{
      \node[anchor=south west,draw=ink,line width=0.9pt,fill=\c!35,minimum height=0.6cm,
            minimum width=2.2cm,inner sep=2pt] at (\i*2.2,\i*0.62) {\bfseries\t};
      \draw[dotted,line width=0.8pt,color=ink!50] (\i*2.2+2.2,\i*0.62+0.3) -- (9.2,\i*0.62+0.3);
      \node[anchor=west,align=left,text width=5.2cm] at (9.3,\i*0.62+0.3) {\d};
    }
  \end{tikzpicture}}

% ---------------------------------------------------------------- ruler drawing
% \ruler{from}{to}  draws a ruler face from whole cm "from" to whole cm "to", 1 cm = 1 cm
\newcommand{\ruler}[2]{%
  \pgfmathtruncatemacro{\rA}{#1*10}\pgfmathtruncatemacro{\rB}{#2*10}%
  \draw[line width=0.9pt,fill=sun!35] (#1-0.15,-0.9) rectangle (#2+0.15,0);
  \foreach \m in {\rA,...,\rB}{%
    \pgfmathsetmacro{\xx}{\m/10}%
    \pgfmathtruncatemacro{\kind}{ifthenelse(mod(\m,10)==0,1,ifthenelse(mod(\m,5)==0,2,3))}%
    \ifnum\kind=1\draw[line width=0.9pt] (\xx,0) -- (\xx,-0.46);\node[font=\sffamily\scriptsize,anchor=north] at (\xx,-0.46) {\pgfmathprintnumber{\xx}};\fi
    \ifnum\kind=2\draw[line width=0.7pt] (\xx,0) -- (\xx,-0.34);\fi
    \ifnum\kind=3\draw[line width=0.4pt] (\xx,0) -- (\xx,-0.2);\fi
  }}

% ---------------------------------------------------------------- word list helper
\newcommand{\word}[2]{\par\noindent{\sans\bfseries #1} \enspace #2\par\vspace{-0.15em}}

