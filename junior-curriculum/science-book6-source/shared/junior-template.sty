% three-line trust box: \trust{checked}{reason}{notshow}
\newcommand{\trust}[3]{%
  \begin{tcolorbox}[enhanced,breakable,colback=tangerine!8,colframe=tangerine,boxrule=1.3pt,arc=3mm,
    left=5pt,right=5pt,top=4pt,bottom=4pt,before skip=8pt,after skip=8pt,
    title={\sans\bfseries\small What makes this correction trustworthy?},coltitle=white,colbacktitle=tangerine,
    fonttitle=\sans\bfseries,attach boxed title to top left={xshift=8pt,yshift*=-2.5mm},
    boxed title style={colback=tangerine,colframe=tangerine,arc=2mm},
    before upper={\small}]
    {\sans\bfseries\color{tangerine!80!black}What we checked.} #1\par\vspace{2pt}
    {\sans\bfseries\color{leaf!80!black}What this check gives us reason to trust.} #2\par\vspace{2pt}
    {\sans\bfseries\color{tomato}What it does not show.} #3
  \end{tcolorbox}}

\newtcolorbox{tryit}[2][]{enhanced,breakable,colback=leaf!8,colframe=leaf,boxrule=1.3pt,arc=3mm,
  left=6pt,right=6pt,top=5pt,bottom=5pt,before skip=9pt,after skip=9pt,
  title={\sans\bfseries\small Try it: #2},coltitle=white,colbacktitle=leaf,fonttitle=\sans\bfseries,
  attach boxed title to top left={xshift=8pt,yshift*=-2.5mm},
  boxed title style={colback=leaf,colframe=leaf,arc=2mm},before upper={\small},#1}

