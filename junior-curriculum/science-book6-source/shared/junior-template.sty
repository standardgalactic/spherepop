% ---------------------------------------------------------------- headings
\newcounter{chap}
\newcommand{\chapterhead}[3]{%
  \clearpage
  \refstepcounter{chap}\setcounter{puz}{0}%
  \renewcommand{\chapterhead@running}{#2}%
  \par\noindent
  \begin{tikzpicture}
    \node[anchor=north west,inner sep=0] at (0,0)
      {\begin{minipage}{\textwidth}\hspace*{2.1cm}\begin{minipage}{\dimexpr\textwidth-2.1cm\relax}
        {\sans\bfseries\LARGE\color{ink}\raggedright #2\par}
        \vspace{2pt}
        {\sans\itshape\small\color{ink!70}\raggedright #3\par}
      \end{minipage}\end{minipage}};
    \node[star,star points=14,star point ratio=0.84,fill=sun,draw=ink,line width=1.2pt,
          minimum size=1.7cm,inner sep=0,font=\sffamily\bfseries\huge,text=ink] at (0.85,-0.82) {#1};
    \draw[line width=2.4pt,color=tangerine,line cap=round] (0,-1.8) -- (\textwidth,-1.8);
    \draw[line width=1pt,color=sky,line cap=round,dash pattern=on 1pt off 4pt] (0,-1.92) -- (\textwidth,-1.92);
  \end{tikzpicture}\par\vspace{0.2cm}}

\newcommand{\subhead}[1]{\par\vspace{0.35em}{\sans\bfseries\large\color{sky!70!black}#1}\nopagebreak\par\vspace{-0.1em}}

% ---------------------------------------------------------------- Multix
\newcommand{\multixbot}[1][ok]{%
  \begin{tikzpicture}[scale=0.62,baseline=(current bounding box.center),line join=round]
    \draw[line width=1.1pt,fill=sun!70,rounded corners=2pt] (-0.55,-1.5) rectangle (0.55,-0.45);
    \draw[line width=1.1pt,fill=white] (-0.25,-1.2) circle (0.12);
    \draw[line width=1.1pt] (0.05,-0.85) -- (0.35,-0.85);
    \draw[line width=1.1pt] (0.05,-1.1) -- (0.35,-1.1);
    \draw[line width=1.1pt] (-0.55,-0.7) -- (-0.95,-1.1);
    \draw[line width=1.1pt] (0.55,-0.7) -- (0.95,-0.4);
    \draw[line width=1.1pt,fill=sky!35,rounded corners=4pt] (-0.8,-0.35) rectangle (0.8,0.85);
    \draw[line width=1.1pt] (0,0.85) -- (0,1.25);
    \fill[tomato,draw=ink,line width=1pt] (0,1.35) circle (0.12);
    \draw[line width=1.1pt,fill=white] (-0.35,0.35) circle (0.2);
    \draw[line width=1.1pt,fill=white] (0.35,0.35) circle (0.2);
    \fill[ink] (-0.33,0.35) circle (0.07);
    \fill[ink] (0.37,0.35) circle (0.07);
    \ifstrequal{#1}{wow}{\draw[line width=1.1pt,fill=white] (0,-0.05) circle (0.12);}{%
    \ifstrequal{#1}{hmm}{\draw[line width=1.1pt] (-0.25,-0.05) -- (0.25,-0.1);}{%
    \draw[line width=1.1pt] (-0.25,-0.02) .. controls (-0.1,-0.17) and (0.1,-0.17) .. (0.25,-0.02);}}
  \end{tikzpicture}}

\newtcolorbox{multix}[1][ok]{enhanced,breakable,colback=sky!8,colframe=sky!80!black,
  boxrule=1.1pt,arc=3mm,left=3pt,right=4pt,top=3pt,bottom=3pt,
  sidebyside,sidebyside align=top,lefthand width=1.25cm,sidebyside gap=1.5mm,
  before skip=7pt,after skip=7pt,
  lower separated=false,
  fontlower=\sffamily\small}
% usage: \begin{multix}[mood] \multixbot[mood] \tcblower text \end{multix}
\newcommand{\multixsays}[2][ok]{%
  \begin{multix}[#1]\multixbot[#1]\tcblower \textbf{Multix:} #2\end{multix}}

